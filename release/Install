; Slicks WHDLoad installation, Installer V43+.
; WHDLoad Install Template conventions, adapted as in Vette's installer.
; $VER: Install 0.1 (30.09.2026)
(set @app-name "Slicks")
(if (< @installer-version (* 43 65536))
  (abort "This installation requires Amiga Installer 43 or newer."))
(welcome)
(set #source (pathonly @icon))
(set @execute-dir #source)
(if (<> 0 (run "cd SYS:\nWhich WHDLoad >NIL:"))
  (abort "Install WHDLoad 17 or newer first. It must be accessible via the command path. See https://www.whdload.de/"))
   (set #kick-ready 0)
   (if (and (exists "Devs:Kickstarts/kick40068.A1200") (exists "Devs:Kickstarts/kick40068.A1200.RTB")) (set #kick-ready 1))
   (if (and (exists "Devs:Kickstarts/kick40068.A4000") (exists "Devs:Kickstarts/kick40068.A4000.RTB")) (set #kick-ready 1))
   (if (and (exists "Devs:Kickstarts/kick40063.A600") (exists "Devs:Kickstarts/kick40063.A600.RTB")) (set #kick-ready 1))
   (if (<> (getassign "WHDCOMMON") "")
     ((if (and (exists "WHDCOMMON:kick40068.A1200") (exists "WHDCOMMON:kick40068.A1200.RTB")) (set #kick-ready 1))
      (if (and (exists "WHDCOMMON:kick40068.A4000") (exists "WHDCOMMON:kick40068.A4000.RTB")) (set #kick-ready 1))
      (if (and (exists "WHDCOMMON:kick40063.A600") (exists "WHDCOMMON:kick40063.A600.RTB")) (set #kick-ready 1))))
   (if (= #kick-ready 0)
     (message "WHDLoad needs a Kickstart 3.1 image and matching .RTB file in Devs:Kickstarts or WHDCOMMON: before playing. See ReadMe for supported image names." (all)))
(set #parent
  (askdir
    (prompt "Where should Slicks be installed? A Slicks drawer will be created here.")
    (help "Choose a hard disk with at least 3 MB free. Existing settings, records and registration keys are preserved.")
    (default @default-dest)))
(set #dest (tackon #parent "Slicks"))
(set #data (tackon #dest "data"))
(set #install-data 1)
(if (and (= (exists (tackon #data "SLICKS.000")) 1)
         (= (exists (tackon #data "SLICKS.DAT")) 1)
         (= (exists (tackon #data "TRACKS")) 2))
  (set #install-data
    (askbool
      (prompt "The original game data files are already installed. Reinstall them or use the existing files?")
      (help "Use existing skips the ZIP and temporary drawer questions and preserves modified tracks and records. Reinstall replaces the 195 supplied tracks and both data files, but never configuration, profiles, championships or your key.")
      (choices "Reinstall" "Use existing") (default 0))))
(if #install-data
  (
    (set #archive
      (askfile (prompt "Select the downloaded Slix151.zip (leave it compressed).")
        (help "Download Slix151.zip from https://www.slicksnslide.com/webapi/download.php?p=dos-slix&v=Slix151.zip . No external UnZip program is required.")
        (default "Slix151.zip")))
    (set #temp
      (askdir (prompt "Select a temporary drawer with at least 2 MB free.")
        (help "RAM: and RAM-backed T: are supported if enough memory is available for staging plus about 1 MB for the helper. A disk drawer is recommended on a 2 MB Amiga.")
        (default #parent)))
    (if (= @pretend 0)
      ((set #attempt 0)
       (set #stage (tackon #temp (".slicks-data-%ld" #attempt)))
       (while (exists #stage)
         ((set #attempt (+ #attempt 1))
          (set #stage (tackon #temp (".slicks-data-%ld" #attempt)))))
       (working "Checking the original ZIP and extracting data. Please wait.")
       (set #result (run ("\"%s\" \"%s\" \"%s\"" (tackon #source "SlicksInstallData") #archive #stage)))
       (if (<> #result 0)
         (abort "Data extraction failed. Existing installation files have not been replaced. Check the ZIP, available RAM and disk space; see the helper error message."))
       (makedir #dest (infos) (help @makedir-help))
       (makedir #data (help @makedir-help))
       (copyfiles (source #stage) (dest #data) (all) (help @copyfiles-help))
       (delete #stage (all) (optional "force"))))))
(makedir #dest (infos) (help @makedir-help))
(makedir #data (help @makedir-help))
(complete 80)
(copyfiles (source (tackon #source "Slicks")) (dest #data) (help @copyfiles-help))
(copyfiles (source (tackon #source "Slicks.slave")) (dest #dest) (help @copyfiles-help))
(copyfiles (source (tackon #source "Slicks.inf")) (dest #dest) (newname "Slicks.info") (help @copyfiles-help))
; Keep these explicit, as in the WHDLoad install template. The game needs no
; other WHDLoad options.
(tooltype (dest (tackon #dest "Slicks")) (setdefaulttool "WHDLoad")
  (settooltype "Slave" "Slicks.slave") (settooltype "PreLoad" "")
  (setstack 16384) (noposition))
; Retire the previous launch icons on upgrades; never remove game data/saves.
(if (= (exists (tackon #dest "Play")) 1)
  (delete (tackon #dest "Play") (optional "force")))
(if (= (exists (tackon #dest "Play.info")) 1)
  (delete (tackon #dest "Play.info") (optional "force")))
(if (= (exists (tackon #dest "SlicksWHDLoad.info")) 1)
  (delete (tackon #dest "SlicksWHDLoad.info") (optional "force")))
(copyfiles (source (tackon #source "ReadMe")) (dest #dest) (infos) (help @copyfiles-help))
(set @default-dest #dest)
(complete 100)
(exit)
