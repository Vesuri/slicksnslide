+uint16_t slicks_decoder_cs = 0;
+PhysPt slicks_runtime_base = 0;
+uint32_t slicks_runtime_size = 0;
+uint32_t slicks_previous_offset = 0;
+bool slicks_previous_valid = false;
+std::vector<uint8_t> slicks_executed;
+std::unordered_set<uint64_t> slicks_edges;
+
+void Slicks_WriteTrace()
+{
+	if (!slicks_trace_active)
+		return;
+	if (auto *output = fopen("slicks-executed.bin", "wb")) {
+		fwrite(slicks_executed.data(), 1, slicks_executed.size(), output);
+		fclose(output);
+	}
+	if (auto *output = fopen("slicks-edges.csv", "w")) {
+		fputs("from_offset,to_offset\n", output);
+		std::vector<uint64_t> sorted_edges(slicks_edges.begin(), slicks_edges.end());
+		std::sort(sorted_edges.begin(), sorted_edges.end());
+		for (const auto edge : sorted_edges)
+			fprintf(output, "0x%05x,0x%05x\n",
+			        static_cast<uint32_t>(edge >> 32),
+			        static_cast<uint32_t>(edge));
+		fclose(output);
+	}
+	LOG_MSG("SLICKS: wrote execution bitmap and %zu unique transitions",
+	        slicks_edges.size());
+}
+
+void Slicks_TraceInstruction(const PhysPt address)
+{
+	const auto cs_value = SegValue(cs);
+	const auto ss_value = SegValue(ss);
+	const auto ip_value = static_cast<uint16_t>(reg_eip);
+
+	if (!slicks_entered_decoder && cs_value == ss_value && ip_value == 0x0642) {
+		slicks_entered_decoder = true;
+		slicks_decoder_cs = cs_value;
+	}
+	if (!slicks_trace_active && slicks_entered_decoder &&
+	    cs_value == slicks_decoder_cs && ip_value == 0x070b &&
+	    mem_readb(address) == 0xea) {
+		const auto final_cs = mem_readw(address + 3);
+		slicks_runtime_base = static_cast<PhysPt>(final_cs) << 4;
+		slicks_runtime_size =
+		        (static_cast<uint32_t>(ss_value - final_cs) << 4) + reg_sp;
+		slicks_executed.assign(slicks_runtime_size, 0);
+		slicks_edges.reserve(262144);
+		slicks_trace_active = true;
+		if (!slicks_trace_registered) {
+			std::atexit(Slicks_WriteTrace);
+			slicks_trace_registered = true;
+		}
+		LOG_MSG("SLICKS: tracing runtime base %05x, %u bytes",
+		        slicks_runtime_base, slicks_runtime_size);
+		return;
+	}
+	if (!slicks_trace_active || address < slicks_runtime_base ||
+	    address >= slicks_runtime_base + slicks_runtime_size) {
+		slicks_previous_valid = false;
+		return;
+	}
+
+	const auto offset = static_cast<uint32_t>(address - slicks_runtime_base);
+	slicks_executed[offset] = 1;
+	if (slicks_previous_valid) {
+		const auto edge = (static_cast<uint64_t>(slicks_previous_offset) << 32) |
+		                  offset;
+		slicks_edges.insert(edge);
+	}
+	slicks_previous_offset = offset;
+	slicks_previous_valid = true;
+}
+
+} // namespace
