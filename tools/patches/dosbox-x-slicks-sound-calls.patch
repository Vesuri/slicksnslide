+void Slicks_RecordSoundCall()
+{
+	if (slicks_sound_calls.size() >= 65536)
+		return;
+	const auto stack = SegPhys(ss) + reg_sp;
+	const auto data = SegPhys(ds);
+	SlicksSoundCall call = {};
+	call.frame = slicks_race_frame;
+	const auto return_address =
+	        (static_cast<PhysPt>(mem_readw(stack + 2)) << 4) +
+	        mem_readw(stack);
+	call.return_offset = return_address >= slicks_runtime_base
+	                             ? static_cast<uint32_t>(return_address - slicks_runtime_base)
+	                             : UINT32_MAX;
+	call.sample_handle = mem_readw(stack + 4);
+	call.sample_block = -1;
+	for (int16_t block = 0; block < 27; ++block) {
+		if (mem_readb(data + 0x4c4a + block) ==
+		    static_cast<uint8_t>(call.sample_handle)) {
+			call.sample_block = block;
+			break;
+		}
+	}
+	call.flags = mem_readw(stack + 6);
+	call.priority = mem_readw(stack + 8);
+	slicks_sound_calls.push_back(call);
+}
