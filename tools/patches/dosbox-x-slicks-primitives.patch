+struct SlicksPrimitiveCall {
+	uint32_t target;
+	uint8_t argc;
+	std::array<uint16_t, 9> args;
+	uint16_t stride;
+	uint8_t source_width;
+	uint8_t source_height;
+
+	bool operator<(const SlicksPrimitiveCall &other) const
+	{
+		return std::tie(target, argc, args, stride, source_width, source_height) <
+		       std::tie(other.target, other.argc, other.args, other.stride,
+		                other.source_width, other.source_height);
+	}
+};
+
+std::map<SlicksPrimitiveCall, uint64_t> slicks_primitive_calls;
+
+void Slicks_RecordPrimitiveCall(const uint32_t target, const uint8_t argc)
+{
+	SlicksPrimitiveCall call = {};
+	call.target = target;
+	call.argc = argc;
+	const auto stack = SegPhys(ss);
+	for (uint8_t i = 0; i < argc; ++i) {
+		const auto stack_offset = static_cast<uint16_t>(reg_sp + 4 + i * 2);
+		call.args[i] = mem_readw(stack + stack_offset);
+	}
+	call.stride = mem_readw(SegPhys(ds) + 0x1d7b);
+	if (target == 0x2a97c || target == 0x2a9f2 || target == 0x2b8de) {
+		const auto pointer_index = target == 0x2b8de ? 6 : 2;
+		const auto source =
+		        (static_cast<PhysPt>(call.args[pointer_index + 1]) << 4) +
+		        call.args[pointer_index];
+		call.source_width = mem_readb(source);
+		call.source_height = mem_readb(source + 1);
+	}
+	++slicks_primitive_calls[call];
+}
