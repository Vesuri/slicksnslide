+		std::array<uint8_t, 768> palette = {};
+		call.palette_hash = UINT64_C(14695981039346656037);
+		for (size_t i = 0; i < 256; ++i) {
+			palette[i * 3] = vga.dac.rgb[i].red;
+			palette[i * 3 + 1] = vga.dac.rgb[i].green;
+			palette[i * 3 + 2] = vga.dac.rgb[i].blue;
+		}
+		for (const auto component : palette) {
+			call.palette_hash ^= component;
+			call.palette_hash *= UINT64_C(1099511628211);
+		}
+		const auto existing_palette = slicks_palettes.find(call.palette_hash);
+		if (existing_palette == slicks_palettes.end())
+			slicks_palettes.emplace(call.palette_hash, palette);
+		else if (existing_palette->second != palette)
+			call.palette_hash = 0;
+	}
+	++slicks_primitive_calls[call];
+}
