+	        mem_readb(data + 0x537c + car),
+	        mem_readb(data + 0x5378 + car),
+	        static_cast<int32_t>(mem_readd(data + 0x538c + car * 4)),
+	        static_cast<int32_t>(mem_readd(data + 0x539c + car * 4)));
+}
