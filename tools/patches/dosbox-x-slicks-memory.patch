+void Slicks_WriteMemoryEvents()
+{
+	if (slicks_memory_events.empty())
+		return;
+	if (auto *output = fopen("slicks-memory.csv", "w")) {
+		fputs("direction,width,region,source_offset,target_offset,count\n", output);
+		for (const auto &item : slicks_memory_events) {
+			const auto &event = item.first;
+			fprintf(output, "%s,%u,%s,0x%05x,0x%05x,%llu\n",
+			        event.write ? "write" : "read", event.width,
+			        event.runtime ? "runtime" : "vga", event.source_offset,
+			        event.target_offset,
+			        static_cast<unsigned long long>(item.second));
+		}
+		fclose(output);
+	}
+	LOG_MSG("SLICKS: wrote %zu memory aggregates covering %llu events",
+	        slicks_memory_events.size(),
+	        static_cast<unsigned long long>(slicks_memory_event_count));
