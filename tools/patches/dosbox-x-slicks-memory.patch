+void Slicks_RecordMemoryAccess(const bool write, const LinearPt address,
+	                           const uint8_t width)
+{
+	if (!slicks_trace_active)
+		return;
+	const auto source_address = SegPhys(cs) + static_cast<uint16_t>(reg_eip);
+	if (source_address < slicks_runtime_base ||
+	    source_address >= slicks_runtime_base + slicks_runtime_size)
+		return;
+	const bool runtime = address >= slicks_runtime_base &&
+	                     address < slicks_runtime_base + slicks_runtime_size;
+	if (!runtime && (address < 0xa0000u || address >= 0xc0000u))
+		return;
+	if (!slicks_memory_writer_registered) {
+		std::atexit(Slicks_WriteMemoryEvents);
+		slicks_memory_writer_registered = true;
+	}
+	const auto target_offset = runtime
+	        ? static_cast<uint32_t>(address - slicks_runtime_base)
+	        : static_cast<uint32_t>((address - 0xa0000u) & ~0xffu);
+	const SlicksMemoryKey key = {
+	        write, width, runtime,
+	        static_cast<uint32_t>(source_address - slicks_runtime_base),
+	        target_offset};
+	++slicks_memory_events[key];
+	++slicks_memory_event_count;
+}
