+void Slicks_RecordRaceStatePre()
+{
+	if (slicks_race_states.size() >= 16384)
+		return;
+	const auto data = SegPhys(ds);
+	if (!slicks_race_data_valid) {
+		for (size_t i = 0; i < slicks_race_data.size(); ++i)
+			slicks_race_data[i] = mem_readb(data + static_cast<PhysPt>(i));
+		slicks_race_data_valid = true;
+	}
+	const auto car = static_cast<uint8_t>(mem_readw(SegPhys(ss) + reg_bp - 0x68));
+	if (car >= 4)
+		return;
+	SlicksRaceState state = {};
+	state.sample = slicks_race_frame * 4 + car;
+	state.car = car;
+	for (uint8_t i = 0; i < 5; ++i)
+		state.controls[i] = mem_readb(data + 0x5344 + car * 5 + i);
+	state.surface = mem_readb(data + 0x2fac + car);
+	state.contact = mem_readb(data + 0x2fb0 + car);
+	state.x = mem_readd(data + 0x538c + car * 4);
+	state.y = mem_readd(data + 0x539c + car * 4);
+	state.heading = mem_readw(data + 0x681c + car * 2);
+	state.steering_input = static_cast<int16_t>(
+	        mem_readw(SegPhys(ss) + reg_bp - 0x48 + car * 2));
+	state.timestep = static_cast<int16_t>(mem_readw(SegPhys(ss) + reg_bp - 2));
+	state.steering_scale = static_cast<int16_t>(mem_readw(data + 0x4c3a + car * 2));
+	state.steering_property = static_cast<int16_t>(mem_readw(data + 0x6aee + car * 0x0e));
+	state.velocity_before_x = static_cast<int32_t>(mem_readd(data + 0x682e + car * 4));
+	state.velocity_before_y = static_cast<int32_t>(mem_readd(data + 0x683e + car * 4));
+	for (uint8_t i = 0; i < sizeof(state.car_state); ++i)
+		state.car_state[i] = mem_readb(data + 0x302f + car * 0x36 + i);
+	for (uint8_t i = 0; i < 7; ++i)
+		state.ai_state[i] = mem_readw(data + 0x6902 + car * 2 + i * 8);
+	slicks_pending_race_states[car] = state;
+	slicks_pending_race_valid[car] = true;
+}
+
+void Slicks_RecordRaceForce(const bool y_axis)
+{
+	const auto car = static_cast<uint8_t>(mem_readw(SegPhys(ss) + reg_bp - 0x68));
+	if (car >= 4 || !slicks_pending_race_valid[car])
+		return;
+	const auto value = static_cast<int32_t>(
+	        (static_cast<uint32_t>(reg_dx) << 16) | reg_ax);
+	if (y_axis)
+		slicks_pending_race_states[car].force_y = value;
+	else
+		slicks_pending_race_states[car].force_x = value;
+}
+
+void Slicks_RecordRaceForceOperands(const bool y_axis)
+{
+	const auto car = static_cast<uint8_t>(mem_readw(SegPhys(ss) + reg_bp - 0x68));
+	if (car >= 4 || !slicks_pending_race_valid[car])
+		return;
+	const auto stack = SegPhys(ss) + reg_sp;
+	const auto numerator = static_cast<int32_t>(
+	        static_cast<uint32_t>(mem_readw(stack)) |
+	        (static_cast<uint32_t>(mem_readw(stack + 2)) << 16));
+	const auto divisor = static_cast<int32_t>(
+	        static_cast<uint32_t>(mem_readw(stack + 4)) |
+	        (static_cast<uint32_t>(mem_readw(stack + 6)) << 16));
+	if (y_axis) {
+		slicks_pending_race_states[car].force_numerator_y = numerator;
+		slicks_pending_race_states[car].force_divisor_y = divisor;
+	} else {
+		slicks_pending_race_states[car].force_numerator_x = numerator;
+		slicks_pending_race_states[car].force_divisor_x = divisor;
+	}
+}
+
+void Slicks_RecordRaceStatePost()
+{
+	const auto data = SegPhys(ds);
+	const auto car = static_cast<uint8_t>(mem_readw(SegPhys(ss) + reg_bp - 0x68));
+	if (car >= 4 || !slicks_pending_race_valid[car])
+		return;
+	auto state = slicks_pending_race_states[car];
+	state.velocity_x = static_cast<int32_t>(mem_readd(data + 0x682e + car * 4));
+	state.velocity_y = static_cast<int32_t>(mem_readd(data + 0x683e + car * 4));
+	state.drive_branch = mem_readb(SegPhys(ss) + reg_bp - 0x5e + car);
+	for (uint8_t i = 0; i < 7; ++i)
+		state.drive_properties[i] = static_cast<int16_t>(
+		        mem_readw(data + 0x6ae2 + car * 0x0e + i * 2));
+	for (uint8_t i = 0; i < 10; ++i)
+		state.q15[i] = static_cast<int16_t>(
+		        mem_readw(data + 0x53d6 + car * 2 + i * 8));
+	slicks_race_states.push_back(state);
+	slicks_pending_race_valid[car] = false;
+	if (car == 3)
+		++slicks_race_frame;
+}
