+void Slicks_RecordRaceState()
+{
+	if (slicks_race_states.size() >= 16384)
+		return;
+	const auto data = SegPhys(ds);
+	if (!slicks_race_data_valid) {
+		for (size_t i = 0; i < slicks_race_data.size(); ++i)
+			slicks_race_data[i] = mem_readb(data + static_cast<PhysPt>(i));
+		slicks_race_data_valid = true;
+	}
+	const auto car = static_cast<uint8_t>(mem_readw(SegPhys(ss) + reg_bp - 0x68));
+	if (car >= 4)
+		return;
+	SlicksRaceState state = {};
+	state.sample = slicks_race_frame * 4 + car;
+	state.car = car;
+	for (uint8_t i = 0; i < 5; ++i)
+		state.controls[i] = mem_readb(data + 0x5344 + car * 5 + i);
+	state.surface = mem_readb(data + 0x2fac + car);
+	state.contact = mem_readb(data + 0x2fb0 + car);
+	state.x = mem_readd(data + 0x538c + car * 4);
+	state.y = mem_readd(data + 0x539c + car * 4);
+	state.heading = mem_readw(data + 0x681c + car * 2);
+	for (uint8_t i = 0; i < sizeof(state.car_state); ++i)
+		state.car_state[i] = mem_readb(data + 0x302f + car * 0x36 + i);
+	for (uint8_t i = 0; i < 7; ++i)
+		state.ai_state[i] = mem_readw(data + 0x6902 + car * 2 + i * 8);
+	slicks_race_states.push_back(state);
+	if (car == 3)
+		++slicks_race_frame;
+}
