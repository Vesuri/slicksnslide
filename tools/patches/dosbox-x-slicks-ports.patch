 #include <vector>
 
 extern bool pcibus_enable;
+extern bool slicks_trace_active;
+extern PhysPt slicks_runtime_base;
+extern uint32_t slicks_runtime_size;
+
+namespace {
+
+struct SlicksPortKey {
+	bool write;
+	uint8_t width;
+	uint16_t port;
+	uint32_t value;
+	uint32_t resume_offset;
+
+	bool operator<(const SlicksPortKey &other) const
+	{
+		return std::tie(write, width, port, value, resume_offset) <
+		       std::tie(other.write, other.width, other.port, other.value,
+		                other.resume_offset);
+	}
+};
+
+std::map<SlicksPortKey, uint64_t> slicks_port_events;
+uint64_t slicks_port_event_count = 0;
+bool slicks_port_writer_registered = false;
+
+void Slicks_WritePortEvents()
+{
+	if (slicks_port_events.empty())
+		return;
+	if (auto *output = fopen("slicks-ports.csv", "w")) {
+		fputs("direction,width,port,value,resume_offset,count\n", output);
+		for (const auto &item : slicks_port_events) {
+			const auto &event = item.first;
+			fprintf(output, "%s,%u,0x%04x,0x%08x,0x%05x,%llu\n",
+			        event.write ? "write" : "read", event.width, event.port,
+			        event.value, event.resume_offset,
+			        static_cast<unsigned long long>(item.second));
+		}
+		fclose(output);
+	}
+	LOG_MSG("SLICKS: wrote %zu port aggregates covering %llu events",
+	        slicks_port_events.size(),
+	        static_cast<unsigned long long>(slicks_port_event_count));
+}
+
+void Slicks_RecordPortEvent(const bool write, const uint8_t width,
+	                        const Bitu port, const uint32_t value)
+{
+	if (!slicks_trace_active)
+		return;
+	const auto address = SegPhys(cs) + static_cast<uint16_t>(reg_eip);
+	if (address < slicks_runtime_base ||
+	    address >= slicks_runtime_base + slicks_runtime_size)
+		return;
+	if (!slicks_port_writer_registered) {
+		std::atexit(Slicks_WritePortEvents);
+		slicks_port_writer_registered = true;
+	}
+	const SlicksPortKey key = {
+	        write, width, static_cast<uint16_t>(port), value,
+	        static_cast<uint32_t>(address - slicks_runtime_base)};
+	++slicks_port_events[key];
+	++slicks_port_event_count;
+}
+
+} // namespace
 
